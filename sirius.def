Bootstrap: docker
From: ubuntu:22.04

# Build-time variables – override with:
#   apptainer build --build-arg SIRIUS_VERSION=6.3.12 sirius.sif sirius.def
%arguments
    SIRIUS_VERSION=6.3.12
    SIRIUS_ARCH=linux-x64

%post
    SIRIUS_VERSION="{{ SIRIUS_VERSION }}"
    SIRIUS_ARCH="{{ SIRIUS_ARCH }}"
    SIRIUS_ZIP="sirius-${SIRIUS_VERSION}-${SIRIUS_ARCH}.zip"
    SIRIUS_URL="https://github.com/sirius-ms/sirius/releases/download/v${SIRIUS_VERSION}/${SIRIUS_ZIP}"

    apt-get update
    apt-get upgrade -y
    apt-get install -y liblapack3 libblas3 wget unzip
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/sirius
    wget -q -O /tmp/${SIRIUS_ZIP} "${SIRIUS_URL}"
    unzip -q /tmp/${SIRIUS_ZIP} -d /tmp/sirius_extract
    # The zip contains a top-level directory; move its contents into /opt/sirius
    mv /tmp/sirius_extract/sirius/* /opt/sirius/ 2>/dev/null || \
        mv /tmp/sirius_extract/*/* /opt/sirius/
    rm -rf /tmp/${SIRIUS_ZIP} /tmp/sirius_extract

    chmod +x /opt/sirius/bin/sirius

%environment
    export PATH=/opt/sirius/bin:$PATH

%runscript
    exec sirius "$@"

%labels
    Version {{ SIRIUS_VERSION }}
    Arch {{ SIRIUS_ARCH }}
    Source https://github.com/sirius-ms/sirius/releases/download/v{{ SIRIUS_VERSION }}/sirius-{{ SIRIUS_VERSION }}-{{ SIRIUS_ARCH }}.zip
    Note Unmodified upstream release, packaged for glibc-2.28 hosts (e.g. CentOS/RHEL 8) via ubuntu:22.04 base (glibc 2.35)

%help
    SIRIUS CLI, packaged in an Apptainer image so it runs on hosts with
    glibc < 2.29 (the bundled CBC solver's native libgfortran/liblapack
    require GLIBC_2.29, which CentOS/RHEL 8's glibc 2.28 doesn't provide).

    Default build:
      apptainer build sirius.sif sirius.def

    Custom version / architecture:
      apptainer build --build-arg SIRIUS_VERSION=6.3.12 \
                      --build-arg SIRIUS_ARCH=linux-x64 \
                      sirius.sif sirius.def

    Usage:
      apptainer run  sirius.sif <sirius args>
      apptainer exec sirius.sif sirius <sirius args>
